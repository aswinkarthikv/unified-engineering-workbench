{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Workbench (CMake)",
            "type": "shell",
            "command": "cmake -B build -G \"MinGW Makefiles\" -DCMAKE_BUILD_TYPE=Release && cmake --build build --config Release",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run All Tests",
            "type": "shell",
            "command": "${workspaceFolder}/Launch.exe --test",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Start Standalone Workbench",
            "type": "shell",
            "command": "${workspaceFolder}/Launch.exe",
            "problemMatcher": []
        }
    ]
}
